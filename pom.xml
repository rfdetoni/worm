<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.3</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>br.com.liviacare</groupId>
    <artifactId>worm-parent</artifactId>
    <version>1.0.3</version>
    <packaging>pom</packaging>
    <name>WORM Parent</name>
    <description>Parent POM for WORM multi-module build</description>
    <url>https://github.com/liviacare/worm</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>Livia Care</name>
            <email>dev@liviacare.com</email>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/rfdetoni/worm.git</connection>
        <developerConnection>scm:git:https://github.com/rfdetoni/worm.git</developerConnection>
        <url>https://github.com/rfdetoni/worm</url>
    </scm>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/rfdetoni/worm</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/rfdetoni/worm</url>
        </snapshotRepository>
    </distributionManagement>
    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <modules>
        <module>worm</module>
        <module>worm-processor</module>
    </modules>
    <!-- Module-specific dependencies and build configuration moved to module 'worm/pom.xml' -->

</project>
